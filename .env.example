# Copy to .env.local; fill the URL and secret from your own Apps Script project.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Official Cloudflare test keys: local development ONLY.
# Replace both with real widget keys before publishing. Production rejects these.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
